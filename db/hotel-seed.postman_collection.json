{
  "info": {
    "name": "Hotel Service Seed",
    "_postman_id": "b2c3d4e5-f6a7-8901-bcde-f12345678901",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://team-06.hotel.34.116.253.250.nip.io"
    },
    {
      "key": "iter",
      "value": "0"
    },
    {
      "key": "hotelName",
      "value": ""
    },
    {
      "key": "hotelCity",
      "value": ""
    },
    {
      "key": "hotelAddress",
      "value": ""
    },
    {
      "key": "hotelStars",
      "value": "3"
    },
    {
      "key": "hotelDesc",
      "value": ""
    },
    {
      "key": "createdHotelId",
      "value": "1"
    },
    {
      "key": "roomNumber",
      "value": "101"
    },
    {
      "key": "roomType",
      "value": "0"
    },
    {
      "key": "roomPrice",
      "value": "1000"
    },
    {
      "key": "roomMaxGuests",
      "value": "2"
    }
  ],
  "item": [
    {
      "name": "Create Hotel",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const cities = ['Kyiv', 'Lviv', 'Odesa', 'Kharkiv', 'Dnipro', 'Zaporizhzhia', 'Vinnytsia', 'Poltava', 'Chernivtsi', 'Uzhhorod'];",
              "const prefixes = ['Grand', 'Royal', 'Palace', 'Premier', 'Elite', 'Central', 'Star', 'Golden', 'Silver', 'Crystal'];",
              "const streets = ['Khreshchatyk', 'Soborna', 'Shevchenka', 'Lesi Ukrainky', 'Peremohy', 'Nezalezhnosti', 'Heroiv', 'Miru'];",
              "",
              "const iter = parseInt(pm.collectionVariables.get('iter') || '0');",
              "const city = cities[iter % cities.length];",
              "const prefix = prefixes[iter % prefixes.length];",
              "const street = streets[iter % streets.length];",
              "",
              "pm.collectionVariables.set('hotelName', prefix + ' ' + city + ' Hotel ' + iter);",
              "pm.collectionVariables.set('hotelCity', city);",
              "pm.collectionVariables.set('hotelAddress', 'вул. ' + street + ', ' + ((iter % 200) + 1));",
              "pm.collectionVariables.set('hotelStars', String((iter % 5) + 1));",
              "pm.collectionVariables.set('hotelDesc', 'A premium hotel located in the heart of ' + city + '. Iteration ' + iter);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "  const json = pm.response.json();",
              "  pm.collectionVariables.set('createdHotelId', String(json.id));",
              "}",
              "pm.test('Hotel created successfully', function() {",
              "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/hotels",
          "host": ["{{baseUrl}}"],
          "path": ["api", "hotels"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{hotelName}}\",\n  \"city\": \"{{hotelCity}}\",\n  \"address\": \"{{hotelAddress}}\",\n  \"starRating\": {{hotelStars}},\n  \"description\": \"{{hotelDesc}}\"\n}"
        }
      }
    },
    {
      "name": "Create Room",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const iter = parseInt(pm.collectionVariables.get('iter') || '0');",
              "const types = [0, 1, 2];",
              "const prices = [800, 1200, 1500, 2000, 2500, 3000, 4000, 5000, 7500, 10000];",
              "const maxGuestsByType = [1, 2, 4];",
              "const type = types[iter % 3];",
              "",
              "pm.collectionVariables.set('roomNumber', String(100 + (iter % 900)));",
              "pm.collectionVariables.set('roomType', String(type));",
              "pm.collectionVariables.set('roomPrice', String(prices[iter % prices.length]));",
              "pm.collectionVariables.set('roomMaxGuests', String(maxGuestsByType[type]));",
              "pm.collectionVariables.set('iter', String(iter + 1));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Room created successfully', function() {",
              "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/rooms",
          "host": ["{{baseUrl}}"],
          "path": ["api", "rooms"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"hotelId\": {{createdHotelId}},\n  \"roomNumber\": \"{{roomNumber}}\",\n  \"type\": {{roomType}},\n  \"pricePerNight\": {{roomPrice}},\n  \"maxGuests\": {{roomMaxGuests}},\n  \"isAvailable\": true\n}"
        }
      }
    }
  ]
}
