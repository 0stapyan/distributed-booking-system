{
  "__inputs": [],
  "__requires": [],
  "annotations": {
    "list": []
  },
  "description": "HotelService personal observability dashboard",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "HTTP Request Rate",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_request_duration_seconds_count{k8s_namespace_name=\"$namespace\", service_name=\"hotel-service\"}[2m])) by (http_route, http_request_method)",
          "legendFormat": "{{http_request_method}} {{http_route}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "HTTP p95 Latency",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_request_duration_seconds_bucket{k8s_namespace_name=\"$namespace\", service_name=\"hotel-service\"}[2m])) by (le, http_route))",
          "legendFormat": "p95 {{http_route}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_server_request_duration_seconds_bucket{k8s_namespace_name=\"$namespace\", service_name=\"hotel-service\"}[2m])) by (le, http_route))",
          "legendFormat": "p50 {{http_route}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_request_duration_seconds_bucket{k8s_namespace_name=\"$namespace\", service_name=\"hotel-service\"}[2m])) by (le, http_route))",
          "legendFormat": "p99 {{http_route}}",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "HTTP Error Rate (5xx)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_request_duration_seconds_count{k8s_namespace_name=\"$namespace\", service_name=\"hotel-service\", http_response_status_code=~\"5..\"}[2m])) / sum(rate(http_server_request_duration_seconds_count{k8s_namespace_name=\"$namespace\", service_name=\"hotel-service\"}[2m]))",
          "legendFormat": "error rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "title": "Hotels Created (total)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum(rate(hotels_created_total{k8s_namespace_name=\"$namespace\", service_name=\"hotel-service\"}[5m])) by (city)",
          "legendFormat": "{{city}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "title": "Rooms Created (total)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum(rate(rooms_created_total{k8s_namespace_name=\"$namespace\", service_name=\"hotel-service\"}[5m])) by (room_type)",
          "legendFormat": "{{room_type}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "title": "Room Price Per Night Distribution (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(rooms_price_per_night_bucket{k8s_namespace_name=\"$namespace\", service_name=\"hotel-service\"}[10m])) by (le, room_type))",
          "legendFormat": "p50 {{room_type}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(rooms_price_per_night_bucket{k8s_namespace_name=\"$namespace\", service_name=\"hotel-service\"}[10m])) by (le, room_type))",
          "legendFormat": "p95 {{room_type}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(rooms_price_per_night_bucket{k8s_namespace_name=\"$namespace\", service_name=\"hotel-service\"}[10m])) by (le, room_type))",
          "legendFormat": "p99 {{room_type}}",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "title": "Runtime \u2014 Heap Size",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "dotnet_gc_last_collection_heap_size_bytes{k8s_namespace_name=\"$namespace\", service_name=\"hotel-service\"}",
          "legendFormat": "{{generation}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "title": "Logs \u2014 HotelService",
      "type": "logs",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki_datasource}"
      },
      "targets": [
        {
          "expr": "{service_name=\"hotel-service\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": false,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 9,
      "title": "Publish Rate vs Consume Rate (msg/sec)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 42
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum(rate(messages_published_total{k8s_namespace_name=\"$namespace\", service=\"hotel-service\"}[2m])) by (queue)",
          "legendFormat": "published {{queue}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(messages_consumed_total{k8s_namespace_name=\"$namespace\", service=\"notification-service\"}[2m])) by (queue)",
          "legendFormat": "consumed {{queue}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "mps",
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "title": "Message Processing Duration (p50 / p95)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 42
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(messages_processing_duration_seconds_bucket{k8s_namespace_name=\"$namespace\", service=\"hotel-service\"}[2m])) by (le, queue))",
          "legendFormat": "p50 {{queue}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(messages_processing_duration_seconds_bucket{k8s_namespace_name=\"$namespace\", service=\"hotel-service\"}[2m])) by (le, queue))",
          "legendFormat": "p95 {{queue}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 11,
      "title": "Outbox Pending Messages",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 50
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "outbox_pending_messages{k8s_namespace_name=\"$namespace\", job=\"hotel-service\"}",
          "legendFormat": "pending",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 10
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 12,
      "title": "Dead Letter Queue Count",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 50
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum(increase(messages_dead_lettered_total{k8s_namespace_name=\"$namespace\"}[5m])) by (queue)",
          "legendFormat": "DLQ {{queue}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 13,
      "title": "Error Rate (failed publishes & consumes)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 50
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum(rate(messages_published_total{k8s_namespace_name=\"$namespace\", service=\"hotel-service\", status=\"failure\"}[2m]))",
          "legendFormat": "publish errors",
          "refId": "A"
        },
        {
          "expr": "sum(rate(messages_consumed_total{k8s_namespace_name=\"$namespace\", service=\"notification-service\", status=\"failure\"}[2m]))",
          "legendFormat": "consume errors",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "mps",
          "custom": {
            "lineWidth": 2
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 14,
      "title": "Saga Outcomes (completed vs compensated vs failed)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 66,
        "w": 12,
        "h": 8
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus"
          },
          "expr": "sum(rate(saga_completed_total{k8s_namespace_name=\"$namespace\",outcome=\"completed\"}[2m]))",
          "legendFormat": "completed"
        },
        {
          "datasource": {
            "type": "prometheus"
          },
          "expr": "sum(rate(saga_completed_total{k8s_namespace_name=\"$namespace\",outcome=\"compensated\"}[2m]))",
          "legendFormat": "compensated"
        },
        {
          "datasource": {
            "type": "prometheus"
          },
          "expr": "sum(rate(saga_completed_total{k8s_namespace_name=\"$namespace\",outcome=\"failed\"}[2m]))",
          "legendFormat": "failed"
        }
      ]
    },
    {
      "id": 15,
      "title": "Active (in-flight) Sagas",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 66,
        "w": 12,
        "h": 8
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 5
              }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus"
          },
          "expr": "sum(saga_active{k8s_namespace_name=\"$namespace\"})",
          "legendFormat": "active sagas"
        }
      ]
    },
    {
      "id": 16,
      "title": "Saga Step Duration (p50 / p95)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 74,
        "w": 12,
        "h": 8
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus"
          },
          "expr": "histogram_quantile(0.50, sum(saga_step_duration_seconds_bucket{k8s_namespace_name=\"$namespace\"}) by (le, step))",
          "legendFormat": "p50 {{step}}"
        },
        {
          "datasource": {
            "type": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum(saga_step_duration_seconds_bucket{k8s_namespace_name=\"$namespace\"}) by (le, step))",
          "legendFormat": "p95 {{step}}"
        }
      ]
    },
    {
      "id": 17,
      "title": "Compensation Rate per Step",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 74,
        "w": 12,
        "h": 8
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus"
          },
          "expr": "sum(rate(saga_compensations_total{k8s_namespace_name=\"$namespace\"}[5m])) by (step)",
          "legendFormat": "{{step}}"
        }
      ]
    },
    {
      "id": 18,
      "title": "End-to-End Saga Duration p95",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 82,
        "w": 24,
        "h": 8
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum(saga_step_duration_seconds_bucket{k8s_namespace_name=\"$namespace\",step=\"end-to-end\"}) by (le))",
          "legendFormat": "p95 end-to-end"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "hotel-service",
    "observability"
