{
  "consumer": {
    "name": "GuestScoreService"
  },
  "interactions": [
    {
      "description": "a request for a guest that does not exist",
      "providerStates": [
        {
          "name": "guest 9999 does not exist"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/internal/guests/9999"
      },
      "response": {
        "body": {
          "createdAt": "1970-01-01T00:00:00Z",
          "exists": false,
          "guestId": 9999
        },
        "headers": {
          "Content-Type": "application/json; charset=utf-8"
        },
        "status": 200
      }
    },
    {
      "description": "a request for a guest that exists",
      "providerStates": [
        {
          "name": "guest 1 exists and was created on 2026-01-01"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/internal/guests/1"
      },
      "response": {
        "body": {
          "createdAt": "2026-01-01T00:00:00Z",
          "exists": true,
          "guestId": 1
        },
        "headers": {
          "Content-Type": "application/json; charset=utf-8"
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pactRust": {
      "ffi": "0.4.27",
      "models": "1.2.8"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "GuestService"
  }
}