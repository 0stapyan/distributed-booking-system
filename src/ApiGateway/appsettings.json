{
  "Jwt": {
    "Authority": "http://localhost:8081/realms/team-06",
    "MetadataAddress": "http://localhost:8081/realms/team-06/.well-known/openid-configuration",
    "Audience": "account"
  },
  "Oidc": {
    "ClientId": "shop-web",
    "ClientSecret": "change-me"
  },
  "ReverseProxy": {
    "Routes": {
      "hotels-route": {
        "ClusterId": "hotel",
        "Match": {
          "Path": "/api/hotels/{**catch-all}"
        }
      },
      "rooms-route": {
        "ClusterId": "hotel",
        "Match": {
          "Path": "/api/rooms/{**catch-all}"
        }
      },
      "bookings-route": {
        "ClusterId": "booking",
        "Match": {
          "Path": "/api/bookings/{**catch-all}"
        }
      },
      "guest-score-route": {
        "ClusterId": "guestscore",
        "Match": {
          "Path": "/api/guest-score/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "hotel": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "booking": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5002"
          }
        }
      },
      "guestscore": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5005"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  }
}