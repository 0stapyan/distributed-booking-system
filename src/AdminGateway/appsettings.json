{
  "Jwt": {
    "Authority": "http://localhost:8081/realms/team-06",
    "MetadataAddress": "http://localhost:8081/realms/team-06/.well-known/openid-configuration",
    "Audience": "account"
  },
  "Oidc": {
    "ClientId": "shop-admin",
    "ClientSecret": "change-me"
  },
  "ReverseProxy": {
    "Routes": {
      "analytics-route": {
        "ClusterId": "analytics",
        "Match": { "Path": "/api/analytics/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/analytics/{**catch-all}" }
        ]
      },
      "admin-hotels-route": {
        "ClusterId": "hotel",
        "Match": { "Path": "/api/hotels/{**catch-all}" }
      }
    },
    "Clusters": {
      "analytics": {
        "Destinations": {
          "primary": { "Address": "http://localhost:5006" }
        }
      },
      "hotel": {
        "Destinations": {
          "primary": { "Address": "http://localhost:5001" }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  }
}